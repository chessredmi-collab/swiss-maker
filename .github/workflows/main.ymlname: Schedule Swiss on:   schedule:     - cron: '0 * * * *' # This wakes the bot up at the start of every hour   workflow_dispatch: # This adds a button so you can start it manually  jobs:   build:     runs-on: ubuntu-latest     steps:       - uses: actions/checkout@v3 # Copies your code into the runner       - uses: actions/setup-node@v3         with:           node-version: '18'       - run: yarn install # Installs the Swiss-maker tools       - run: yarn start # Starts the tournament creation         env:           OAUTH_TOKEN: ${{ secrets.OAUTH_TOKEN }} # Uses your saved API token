name: Schedule Swiss
on:
  schedule:
    - cron: '0 * * * *' # Wakes up every hour
  workflow_dispatch: # Gives you a manual "Start" button

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-node@v3
        with:
          node-version: '18'
      - run: yarn install
      - run: yarn start
        env:
          OAUTH_TOKEN: ${{ secrets.OAUTH_TOKEN }}
